/* 基础样式 */
.checkin-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #b9fff9 0%, #6c7afc 100%);
  padding: 20rpx;
}

/* 头部积分 */
.header {
  padding: 40rpx 30rpx;
}

.points-info {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.points-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.points-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
}

/* 签到卡片 */
.checkin-card {
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.checkin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.checkin-date {
  font-size: 28rpx;
  color: #666;
}

/* 签到按钮 */
.checkin-button-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checkin-button {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  transition: all 0.3s ease;
  box-shadow: 0 10rpx 30rpx rgba(255, 154, 158, 0.3);
}

.checkin-button.checked {
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
}

.checkin-button.animate {
  animation: pulse 0.5s ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.button-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.button-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #ff9a9e;
  margin-bottom: 20rpx;
}

.checkin-button.checked .button-icon {
  color: #a1c4fd;
}

.button-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.button-points {
  position: absolute;
  bottom: -40rpx;
  background: #1890ff;
  color: white;
  padding: 10rpx 30rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
}

.checkin-tips {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #666;
  font-size: 24rpx;
}

.rules-link {
  color: #1890ff;
  margin-top: 10rpx;
  font-size: 26rpx;
}

/* 日历卡片 */
.calendar-card {
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.calendar-title {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.calendar-title text {
  font-size: 32rpx;
  font-weight: bold;
}

.today-btn {
  background: #1890ff;
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.month-switcher {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.month-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.switch-btn {
  font-size: 40rpx;
  color: #1890ff;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

/* 星期行 */
.weekdays {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 0;
}

/* 日历格子 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 50%;
}

.calendar-day.current-month {
  color: #333;
}

.calendar-day.other-month {
  color: #ccc;
}

.calendar-day.today {
  background: #1890ff;
  color: white;
}

.calendar-day.checked .day-number {
  color: #1890ff;
  font-weight: bold;
}

.day-number {
  font-size: 28rpx;
}

.check-icon {
  position: absolute;
  bottom: 5rpx;
  font-size: 20rpx;
  color: #ff9a9e;
}

.calendar-day.today .check-icon {
  color: white;
}

/* 签到记录 */
.record-card {
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.record-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.record-count {
  font-size: 26rpx;
  color: #1890ff;
}

.empty-record {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 15rpx;
}

.record-date {
  font-size: 28rpx;
  color: #666;
}

.record-status {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 500;
}

/* 底部提示 */
.footer-tips {
  text-align: center;
  padding: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}
/* pages/checkin/checkin.wxss 中添加以下样式 */

/* 按钮状态样式 */
.checkin-button.default {
    background: linear-gradient(135deg, #ffcece, #ff8a94);
    border-color: #ff8b95;
  }
  
  .checkin-button.checking {
    background: linear-gradient(135deg, #ffe2ab, #ffc386);
    border-color: #ffdbb6;
    opacity: 0.8;
  }
  
  .checkin-button.checked {
    background: linear-gradient(135deg, #a0e4ff, #59a9ff);
    border-color: #7cbbff;
  }
  
  .checkin-button.completed {
    background: linear-gradient(135deg, #98ffd7, #5affb2);
    border-color: #74ffa9;
  }
  
  /* 动画效果 */
  .checkin-button.animate {
    animation: pulse 0.5s ease-in-out;
  }
  
  .checkin-button.success {
    animation: bounce 0.6s ease-in-out;
  }
  
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10rpx); }
  }
  
  /* 按钮内部样式 */
  .button-icon {
    font-size: 36rpx;
    font-weight: bold;
    color: white;
    margin-right: 10rpx;
  }
  
  .button-text {
    font-size: 32rpx;
    font-weight: bold;
    color: white;
  }
  
  .button-points {
    font-size: 24rpx;
    color: #ffd700;
    font-weight: bold;
    margin-top: 10rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  }
  
  /* 签到时间显示 */
  .button-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .button-inner .button-text {
    font-size: 28rpx;
  }