/* pages/project-detail/project-detail.wxss */

.project-detail-container {
    min-height: 100vh;
    background: #f5f5f5;
  }
  
  /* 项目头部 */
  .project-header {
    background: linear-gradient(135deg, var(--project-color, #1890ff) 0%, #096dd9 100%);
    color: white;
    padding: 40rpx 30rpx;
    border-radius: 0 0 30rpx 30rpx;
  }
  
  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  
  .project-meta {
    flex: 1;
    margin-right: 20rpx;
  }
  
  .project-icon {
    font-size: 48rpx;
    display: block;
    margin-bottom: 20rpx;
  }
  
  .project-name {
    font-size: 36rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 12rpx;
  }
  
  .project-desc {
    font-size: 26rpx;
    opacity: 0.9;
    line-height: 1.4;
    display: block;
  }
  
  .project-actions {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
  }
  
  .action-btn {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 12rpx 24rpx;
    border-radius: 25rpx;
    font-size: 24rpx;
    text-align: center;
    min-width: 100rpx;
  }
  
  .action-btn.edit {
    background: rgba(255, 255, 255, 0.1);
  }
  
  /* 标签页导航 */
  .tab-nav {
    display: flex;
    background: white;
    margin: 30rpx;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  }
  
  .tab-item {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    font-size: 28rpx;
    color: #666;
    position: relative;
  }
  
  .tab-item.active {
    color: var(--project-color, #1890ff);
    font-weight: 500;
  }
  
  .tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 4rpx;
    background: var(--project-color, #1890ff);
    border-radius: 2rpx;
  }
  
  /* 标签页内容 */
  .tab-content {
    padding: 0 30rpx 30rpx;
  }
  
  /* 统计网格 */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20rpx;
    margin-bottom: 30rpx;
  }
  
  .stat-card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    text-align: center;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .stat-label {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 12rpx;
  }
  
  .stat-value {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: var(--project-color, #1890ff);
  }
  
  /* 进度卡片 */
  .progress-card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .progress-title {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  
  .progress-text {
    font-size: 26rpx;
    color: var(--project-color, #1890ff);
    font-weight: 500;
  }
  
  .progress-bar {
    height: 16rpx;
    background: #f0f0f0;
    border-radius: 8rpx;
    overflow: hidden;
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--project-color, #1890ff), #096dd9);
    border-radius: 8rpx;
    transition: width 0.3s ease;
  }
  
  /* 连续记录卡片 */
  .streak-card,
  .card-header {
    margin-bottom: 20rpx;
  }
  
  .card-title {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  
  .streak-list {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .streak-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .streak-item:last-child {
    border-bottom: none;
  }
  
  .streak-date {
    font-size: 26rpx;
    color: #666;
  }
  
  .streak-days {
    font-size: 24rpx;
    color: var(--project-color, #1890ff);
    background: rgba(24, 144, 255, 0.1);
    padding: 6rpx 16rpx;
    border-radius: 16rpx;
  }
  
  /* 日历样式 */
  .calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: white;
    border-radius: 20rpx 20rpx 0 0;
    margin-bottom: 0;
  }
  
  .month-btn {
    font-size: 36rpx;
    color: var(--project-color, #1890ff);
    padding: 10rpx 30rpx;
    font-weight: bold;
  }
  
  .month-text {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
  }
  
  .weekdays {
    display: flex;
    justify-content: space-between;
    background: white;
    padding: 20rpx 30rpx 0;
  }
  
  .weekday {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    color: #666;
    padding: 10rpx 0;
  }
  
  .calendar-grid {
    display: flex;
    flex-wrap: wrap;
    background: white;
    padding: 0 30rpx 30rpx;
    border-radius: 0 0 20rpx 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .calendar-day {
    width: calc(100% / 7);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    font-size: 28rpx;
    color: #333;
  }
  
  .calendar-day.checked {
    color: white;
    background: var(--project-color, #1890ff);
    border-radius: 50%;
  }
  
  .calendar-day.today {
    background: #ff9800;
    color: white;
    border-radius: 50%;
  }
  
  .check-mark {
    position: absolute;
    bottom: 5rpx;
    font-size: 20rpx;
    font-weight: bold;
  }
  
  /* 记录列表 */
  .records-list {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .record-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .record-item:last-child {
    border-bottom: none;
  }
  
  .record-date {
    display: flex;
    flex-direction: column;
  }
  
  .date-text {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 8rpx;
  }
  
  .day-of-week {
    font-size: 24rpx;
    color: #666;
  }
  
  .record-info {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  
  .record-points {
    font-size: 28rpx;
    color: var(--project-color, #1890ff);
    font-weight: 500;
    margin-bottom: 8rpx;
  }
  
  .record-streak {
    font-size: 24rpx;
    color: #52c41a;
    background: rgba(82, 196, 26, 0.1);
    padding: 4rpx 12rpx;
    border-radius: 12rpx;
  }
  
  .empty-records {
    text-align: center;
    padding: 80rpx 0;
  }
  
  .empty-icon {
    font-size: 80rpx;
    display: block;
    margin-bottom: 24rpx;
    opacity: 0.5;
  }
  
  .empty-text {
    font-size: 28rpx;
    color: #999;
    display: block;
  }
  
  /* 设置列表 */
  .settings-list {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .setting-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .setting-item:last-child {
    border-bottom: none;
  }
  
  .setting-label {
    font-size: 28rpx;
    color: #333;
  }
  
  .setting-label.danger {
    color: #ff4d4f;
  }
  
  .setting-arrow {
    font-size: 36rpx;
    color: #999;
    transform: scaleY(1.5);
  }
  
  /* 模态框样式 */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 40rpx;
  }
  
  .modal-content {
    background: white;
    border-radius: 30rpx;
    width: 100%;
    max-width: 600rpx;
    overflow: hidden;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  }
  
  .modal-content.danger {
    border: 2rpx solid #ff4d4f;
  }
  
  .modal-header {
    padding: 40rpx 40rpx 20rpx;
    text-align: center;
  }
  
  .modal-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
  }
  
  .modal-body {
    padding: 0 40rpx 40rpx;
    text-align: center;
  }
  
  .modal-body text {
    display: block;
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
  }
  
  .modal-tip {
    font-size: 24rpx;
    color: #999;
    margin-top: 12rpx;
  }
  
  .modal-footer {
    display: flex;
    padding: 0 40rpx 40rpx;
    gap: 20rpx;
  }
  
  /* 按钮样式 */
  .btn {
    flex: 1;
    padding: 24rpx;
    text-align: center;
    border-radius: 16rpx;
    font-size: 28rpx;
    font-weight: 500;
  }
  
  .btn-primary {
    background: var(--project-color, #1890ff);
    color: white;
  }
  
  .btn-secondary {
    background: #f8f9fa;
    color: #666;
  }
  
  .btn-danger {
    background: #ff4d4f;
    color: white;
  }
  
  /* 响应式适配 */
  @media (max-width: 375px) {
    .project-icon {
      font-size: 40rpx;
    }
    
    .project-name {
      font-size: 32rpx;
    }
    
    .stat-card {
      padding: 24rpx;
    }
    
    .stat-value {
      font-size: 32rpx;
    }
  }
  
  /* 暗色模式适配 */
  @media (prefers-color-scheme: dark) {
    .project-detail-container {
      background: #1a1a1a;
    }
    
    .tab-nav,
    .stat-card,
    .progress-card,
    .streak-list,
    .records-list,
    .settings-list,
    .modal-content {
      background: #2a2a2a;
      color: white;
    }
    
    .project-name,
    .progress-title,
    .card-title,
    .date-text,
    .setting-label {
      color: white;
    }
    
    .project-desc,
    .day-of-week,
    .modal-body text {
      color: #aaa;
    }
    
    .modal-content.danger {
      border-color: #d9363e;
    }
  }