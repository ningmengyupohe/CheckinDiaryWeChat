/* pages/profile/profile.wxss */
page {
    background: linear-gradient(135deg, #b9fff9 0%, #6c7afc 100%);
    min-height: 100vh;
  }
  
  .profile-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #b9fff9 0%, #6c7afc 100%);
    padding-bottom: 200rpx;
    position: relative;
    overflow: hidden;
  }
  
  /* 添加背景装饰元素 */
  .profile-page::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400rpx;
    height: 400rpx;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    z-index: 0;
  }
  
  .profile-page::after {
    content: '';
    position: absolute;
    bottom: -100rpx;
    left: -10%;
    width: 300rpx;
    height: 300rpx;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    z-index: 0;
  }
  
  .content {
    padding: 40rpx 30rpx 160rpx;
    position: relative;
    z-index: 1;
  }
  
  .card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20rpx);
    border-radius: 30rpx;
    padding: 40rpx;
    margin-bottom: 30rpx;
    box-shadow: 
      0 20rpx 60rpx rgba(0, 0, 0, 0.08),
      0 8rpx 32rpx rgba(0, 0, 0, 0.05);
    border: 1rpx solid rgba(255, 255, 255, 0.2);
    position: relative;
    z-index: 2;
  }
  
  .card-title {
    font-size: 36rpx;
    font-weight: 700;
    color: #333;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 2rpx solid rgba(240, 240, 240, 0.8);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .card-title::after {
    content: '';
    width: 60rpx;
    height: 4rpx;
    background: linear-gradient(90deg, #667eea, #764ba2);
    border-radius: 2rpx;
    margin-left: 20rpx;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    position: relative;
  }
  
  .user-avatar {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      0 20rpx 60rpx rgba(24, 144, 255, 0.3),
      0 8rpx 32rpx rgba(102, 126, 234, 0.2),
      inset 0 0 0 4rpx rgba(255, 255, 255, 0.8);
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .user-avatar::before {
    content: '';
    position: absolute;
    top: -10%;
    left: -10%;
    width: 120%;
    height: 120%;
    background: linear-gradient(45deg, transparent, rgba(255,255,255,0.2), transparent);
    transform: rotate(45deg);
  }
  
  .avatar-text {
    color: white;
    font-size: 48rpx;
    font-weight: bold;
    position: relative;
    z-index: 1;
  }
  
  .user-details {
    flex: 1;
    margin-left: 40rpx;
  }
  
  .user-name {
    font-size: 40rpx;
    font-weight: 700;
    color: #333;
    margin-bottom: 12rpx;
    line-height: 1.2;
    display: flex;
    align-items: center;
  }
  
  .user-name::after {
    content: '👋';
    margin-left: 12rpx;
    font-size: 32rpx;
    animation: wave 2s infinite;
  }
  
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-10deg); }
    75% { transform: rotate(10deg); }
  }
  
  .user-level {
    font-size: 28rpx;
    color: #1890ff;
    margin-bottom: 30rpx;
    font-weight: 500;
    line-height: 1.2;
    display: flex;
    align-items: center;
  }
  
  .user-level::before {
    content: '⭐';
    margin-right: 8rpx;
    font-size: 24rpx;
  }
  
  .user-stats {
    display: flex;
    justify-content: space-between;
    gap: 20rpx;
    margin-top: 30rpx;
  }
  
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    padding: 20rpx 10rpx;
    background: linear-gradient(135deg, rgba(248, 249, 255, 0.9) 0%, rgba(240, 244, 255, 0.9) 100%);
    border-radius: 20rpx;
    border: 1rpx solid rgba(232, 244, 255, 0.8);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .stat:hover {
    transform: translateY(-4rpx);
    box-shadow: 0 12rpx 32rpx rgba(24, 144, 255, 0.15);
  }
  
  .stat-number {
    font-size: 38rpx;
    font-weight: 700;
    color: #1890ff;
    margin-bottom: 8rpx;
    line-height: 1;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  }
  
  .stat-label {
    font-size: 24rpx;
    color: #666;
    line-height: 1;
    opacity: 0.9;
  }
  
  .menu-list {
    padding: 10rpx 0;
  }
  
  .menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32rpx 0;
    border-bottom: 1rpx solid rgba(245, 245, 245, 0.8);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .menu-item:last-child {
    border-bottom: none;
  }
  
  .menu-item:active {
    background-color: rgba(248, 249, 250, 0.6);
    border-radius: 20rpx;
    margin: 0 -10rpx;
    padding: 32rpx 10rpx;
    transform: scale(0.98);
  }
  
  .menu-left {
    display: flex;
    align-items: center;
    flex: 1;
  }
  
  .menu-icon {
    width: 70rpx;
    height: 70rpx;
    border-radius: 18rpx;
    background: linear-gradient(135deg, #1890ff20 0%, #096dd920 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 28rpx;
    font-size: 34rpx;
    line-height: 1;
    flex-shrink: 0;
    color: #1890ff;
    transition: all 0.3s ease;
  }
  
  .menu-item:active .menu-icon {
    transform: rotate(15deg) scale(1.1);
  }
  
  .menu-text {
    font-size: 32rpx;
    color: #333;
    font-weight: 500;
    line-height: 1.2;
  }
  
  .menu-arrow {
    color: #ccc;
    font-size: 28rpx;
    font-weight: bold;
    margin-left: 20rpx;
    transition: all 0.3s ease;
  }
  
  .menu-item:active .menu-arrow {
    transform: translateX(8rpx);
    color: #1890ff;
  }
  
  .action-buttons {
    width: 100%;
    margin-top: 50rpx;
    display: flex;
    flex-direction: column;
    gap: 24rpx;
    background: transparent;
    position: relative;
    z-index: 2;
  }
  
  .btn {
    width: 100%;
    height: 100rpx;
    border: none;
    border-radius: 25rpx;
    font-size: 34rpx;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: transparent;
    backdrop-filter: blur(10rpx);
  }
  
  .btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.6s ease;
  }
  
  .btn:active::before {
    left: 100%;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, rgb(74, 34, 255) 100%) !important;
    color: white !important;
    border: none !important;
    box-shadow: 
      0 16rpx 40rpx rgba(102, 126, 234, 0.4),
      0 4rpx 12rpx rgba(102, 126, 234, 0.2) !important;
  }
  
  .btn-primary:active {
    transform: translateY(4rpx) scale(0.99);
    box-shadow: 
      0 8rpx 24rpx rgba(102, 126, 234, 0.3),
      0 2rpx 6rpx rgba(102, 126, 234, 0.15) !important;
  }
  
  .btn-outline {
    background: rgba(255, 255, 255, 0.9) !important;
    border: 2rpx solid #ff6b6b !important;
    color: #ff6b6b !important;
    box-shadow: 0 12rpx 32rpx rgba(255, 107, 107, 0.15) !important;
  }
  
  .btn-outline:active {
    background: #ff6b6b !important;
    color: white !important;
    transform: translateY(4rpx) scale(0.99);
    box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.25) !important;
  }
  
  .btn-text {
    font-weight: 600;
    letter-spacing: 1rpx;
    position: relative;
    z-index: 1;
  }
  
  .pic {
    border-radius: 50%;
    display: block;
    width: 140rpx;
    height: 140rpx;
    border: 6rpx solid rgba(255, 255, 255, 0.9);
    box-shadow: 
      0 20rpx 60rpx rgba(0, 0, 0, 0.2),
      0 0 0 1rpx rgba(255, 255, 255, 0.3),
      inset 0 0 0 4rpx rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
    object-fit: cover;
  }
  
  .pic:active {
    transform: scale(0.95) rotate(5deg);
  }
  
  .safe-area {
    padding-bottom: env(safe-area-inset-bottom);
    padding-bottom: constant(safe-area-inset-bottom);
  }
  
  .footer-space {
    height: 120rpx;
    width: 100%;
    background: transparent;
  }
  
  /* 响应式调整 */
  @media (max-width: 375px) {
    .content {
      padding: 30rpx 20rpx 140rpx;
    }
    
    .card {
      padding: 30rpx;
      margin-bottom: 24rpx;
      border-radius: 24rpx;
    }
    
    .user-details {
      margin-left: 30rpx;
    }
    
    .user-name {
      font-size: 36rpx;
    }
    
    .user-level {
      font-size: 26rpx;
    }
    
    .stat-number {
      font-size: 34rpx;
    }
    
    .stat-label {
      font-size: 22rpx;
    }
    
    .menu-text {
      font-size: 30rpx;
    }
  }
  
  /* 修复白条问题的关键 */
  .fixed-bottom {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(135deg, #b9fff9 0%, #6c7afc 100%);
    z-index: 1000;
    height: env(safe-area-inset-bottom);
  }
  
  /* 滚动优化 */
  scroll-view {
    height: 100vh;
  }
  
  /* 加载动画 */
  .loading-shimmer {
    background: linear-gradient(90deg, 
      rgba(255,255,255,0) 0%, 
      rgba(255,255,255,0.2) 50%, 
      rgba(255,255,255,0) 100%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  
  /* 触摸反馈优化 */
  .touch-active {
    opacity: 0.7;
    transform: scale(0.98);
  }

  /* 登录提示区域 */
.login-section {
    margin: 30rpx;
  }
  
  /* 登录提示卡片 */
  .card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 24rpx;
    padding: 40rpx 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.08);
    border: 1rpx solid rgba(230, 247, 255, 0.8);
    position: relative;
    overflow: hidden;
  }
  
  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 8rpx;
    height: 100%;
    background: linear-gradient(to bottom, #1890ff, #096dd9);
    border-radius: 24rpx 0 0 24rpx;
  }
  
  .login-prompt {
    text-align: center;
    padding: 60rpx 40rpx;
    background: linear-gradient(135deg, #e6f7ff 0%, #f0f8ff 100%);
    border-radius: 24rpx;
    border: 2rpx solid #bae7ff;
    box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.1);
  }
  
  .login-icon {
    font-size: 80rpx;
    margin-bottom: 30rpx;
    display: block;
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }
  
  .login-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #1890ff;
    display: block;
    margin-bottom: 20rpx;
    line-height: 1.4;
    text-shadow: 0 2rpx 4rpx rgba(24, 144, 255, 0.1);
  }
  
  .login-subtitle {
    font-size: 28rpx;
    color: #666;
    display: block;
    margin-bottom: 40rpx;
    line-height: 1.5;
    opacity: 0.8;
  }