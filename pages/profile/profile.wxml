<!-- pages/profile/profile.wxml -->
<view class="profile-page">
  <!-- 用户信息区域 -->
  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="user-info">
      <view class="user-avatar">
        <image class="pic" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      </view>
      <view class="user-details">
        <text class="user-name">{{userInfo.nickname}}</text>
        <text class="user-level">连续打卡 {{continuousDays}} 天</text>
        <view class="user-stats">
          <view class="stat">
            <text class="stat-number">{{userInfo.stats.projects}}</text>
            <text class="stat-label">项目数</text>
          </view>
          <view class="stat">
            <text class="stat-number">{{userInfo.stats.completionRate}}</text>
            <text class="stat-label">完成率</text>
          </view>
          <view class="stat">
            <text class="stat-number">{{userInfo.stats.badges}}</text>
            <text class="stat-label">徽章</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 登录提示区域 -->
  <view class="card" wx:if="{{!isLoggedIn}}">
    <view class="login-prompt">
      <view class="login-icon">🔐</view>
      <text class="login-title">登录后可保存您的打卡数据</text>
      <text class="login-subtitle">登录后，您的数据将安全保存并可在多设备同步</text>
      <button class="btn btn-primary" bindtap="showLoginOptions">
        <text class="btn-text">立即登录</text>
      </button>
    </view>
  </view>

  <!-- 数据管理区域 -->
  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="card-title">数据管理</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="navigateTo" data-page="achievements">
        <view class="menu-left">
          <text class="menu-icon">🏆</text>
          <text class="menu-text">成就徽章</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-page="statistics">
        <view class="menu-left">
          <text class="menu-icon">📊</text>
          <text class="menu-text">数据统计</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 支持与反馈区域 -->
  <view class="card">
    <view class="card-title">支持与反馈</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-left">
          <text class="menu-icon">💬</text>
          <text class="menu-text">问题反馈</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-left">
          <text class="menu-icon">❓</text>
          <text class="menu-text">使用帮助</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 设置区域 -->
  <view class="card">
    <view class="card-title">设置</view>
    <view class="menu-list">
      <!-- 跳转到已有的编辑资料页面 -->
      <view class="menu-item" wx:if="{{isLoggedIn}}" bindtap="editProfile">
        <view class="menu-left">
          <text class="menu-icon">👤</text>
          <text class="menu-text">修改资料</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" wx:if="{{isLoggedIn}}" bindtap="showDataManagement">
        <view class="menu-left">
          <text class="menu-icon">💾</text>
          <text class="menu-text">数据管理</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-page="settings">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-text">应用设置</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 操作按钮（分享） -->
  <view wx:if="{{isLoggedIn}}">
    <view class="action-buttons">
      <button class="btn btn-primary" bindtap="onShareProfile">
        <text class="btn-text">分享成绩</text>
      </button>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-container" wx:if="{{isLoggedIn}}" style="margin-top: 30rpx;">
    <button class="btn btn-outline" bindtap="logout">
      <text class="logout-text">退出登录</text>
    </button>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-area"></view>
</view>