/* pages/badges/badges.wxss */
page {
    background-color: linear-gradient(135deg, #b9fff9 0%, #6c7afc 100%);
    min-height: 100vh;
    height: auto;
  }
  
  .badges-page {
    padding: 0 20rpx;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  /* 加载状态 */
  .loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
  }
  
  .loading {
    text-align: center;
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #999;
  }
  
  /* 主要内容区域 */
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  /* 标签页头部 */
  .tabs-header {
    display: flex;
    background-color: #fff;
    border-radius: 12rpx;
    margin: 20rpx 0;
    padding: 8rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
    flex-shrink: 0;
  }
  
  .tab-item {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    position: relative;
  }
  
  .tab-text {
    font-size: 30rpx;
    color: #666;
    font-weight: 500;
  }
  
  .tab-item.active .tab-text {
    color: #07c160;
    font-weight: 600;
  }
  
  .tab-indicator {
    position: absolute;
    bottom: -8rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 60rpx;
    height: 4rpx;
    background-color: transparent;
    border-radius: 2rpx;
  }
  
  .tab-indicator.active {
    background-color: #07c160;
  }
  
  /* 标签页内容 */
  .tab-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  /* 统计头部 - 共用 */
  .stats-header {
    border-radius: 20rpx;
    padding: 40rpx 32rpx;
    margin: 20rpx 0;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
    color: white;
    flex-shrink: 0;
  }
  
  /* 徽章统计头部 */
  .stats-header .stats-card {
    margin-bottom: 40rpx;
  }
  
  .stats-item {
    text-align: center;
  }
  
  .stats-number {
    display: block;
    font-size: 72rpx;
    font-weight: bold;
    margin-bottom: 8rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  }
  
  .stats-label {
    display: block;
    font-size: 28rpx;
    opacity: 0.9;
  }
  
  /* 徽章数据统计 */
  .data-stats {
    display: flex;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 16rpx;
    padding: 32rpx 20rpx;
    backdrop-filter: blur(10rpx);
  }
  
  .data-item {
    flex: 1;
    text-align: center;
  }
  
  .data-value {
    display: block;
    font-size: 44rpx;
    font-weight: bold;
    margin-bottom: 12rpx;
    color: #FFD93D;
  }
  
  .data-label {
    display: block;
    font-size: 24rpx;
    opacity: 0.85;
  }
  
  /* 成就统计 */
  .level-stats {
    display: flex;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 16rpx;
    padding: 32rpx 20rpx;
    backdrop-filter: blur(10rpx);
  }
  
  .level-item {
    flex: 1;
    text-align: center;
  }
  
  .level-value {
    display: block;
    font-size: 44rpx;
    font-weight: bold;
    margin-bottom: 12rpx;
    color: #FFD93D;
  }
  
  .level-label {
    display: block;
    font-size: 24rpx;
    opacity: 0.85;
  }
  
  /* 分类标签 */
  .category-tabs {
    white-space: nowrap;
    margin: 20rpx 0;
    flex-shrink: 0;
  }
  
  .tabs-container {
    display: flex;
    padding: 0 20rpx;
  }
  
  .category-tabs .tab-item {
    flex: none;
    width: auto;
    padding: 20rpx 40rpx;
    margin-right: 20rpx;
    background-color: white;
    border-radius: 40rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
    border: 2rpx solid transparent;
  }
  
  .category-tabs .tab-item.active {
    background-color: #07c160;
    border-color: #07c160;
  }
  
  .category-tabs .tab-text {
    font-size: 26rpx;
    color: #333;
  }
  
  .category-tabs .tab-item.active .tab-text {
    color: white;
  }
  
  /* 徽章列表容器 */
  .badges-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .badges-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24rpx;
    padding: 20rpx 0;
    flex: 1;
  }
  
  .badge-item {
    background: white;
    border-radius: 20rpx;
    padding: 32rpx 20rpx;
    text-align: center;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    position: relative;
    border: 2rpx solid transparent;
    min-height: 200rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .badge-item.unlocked {
    border-color: rgba(7, 193, 96, 0.2);
  }
  
  .badge-item.locked {
    opacity: 0.7;
  }
  
  .badge-icon-wrapper {
    position: relative;
    margin-bottom: 20rpx;
    flex-shrink: 0;
  }
  
  .badge-icon {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  
  .icon-text {
    font-size: 48rpx;
  }
  
  .unlocked-badge {
    position: absolute;
    top: -8rpx;
    right: -8rpx;
    width: 40rpx;
    height: 40rpx;
    background-color: #07c160;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3rpx solid white;
    box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.3);
  }
  
  .unlocked-text {
    color: white;
    font-size: 24rpx;
    font-weight: bold;
  }
  
  .badge-name {
    display: block;
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 16rpx;
    word-break: break-word;
  }
  
  .progress-info {
    margin-bottom: 16rpx;
    flex-shrink: 0;
  }
  
  .mini-progress {
    height: 8rpx;
    background-color: #f0f0f0;
    border-radius: 4rpx;
    overflow: hidden;
    margin-bottom: 8rpx;
  }
  
  .mini-progress-fill {
    height: 100%;
    border-radius: 4rpx;
    transition: width 0.3s ease;
  }
  
  .progress-text {
    font-size: 22rpx;
    color: #666;
  }
  
  .badge-status {
    display: block;
    font-size: 24rpx;
    padding: 6rpx 16rpx;
    border-radius: 16rpx;
    font-weight: 500;
    margin: 0 auto;
    width: fit-content;
    flex-shrink: 0;
  }
  
  .badge-status.unlocked-text {
    background-color: #e8f5e9;
    color: #07c160;
  }
  
  .badge-status.locked-text {
    background-color: #f5f5f5;
    color: #999;
  }
  
  /* 成就列表容器 */
  .achievements-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding-bottom: 40rpx;
  }
  
  /* 成就卡片 */
  .achievement-item {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
    border-left: 8rpx solid #07c160;
    position: relative;
    min-height: 200rpx;
  }
  
  .achievement-item.unlocked {
    border-left-color: #07c160;
  }
  
  .achievement-item.locked {
    border-left-color: #dcdfe6;
    opacity: 0.8;
  }
  
  .achievement-icon {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    border: 4rpx solid;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 32rpx;
    top: 40rpx;
  }
  
  .achievement-content {
    margin-left: 100rpx;
    min-height: 120rpx;
  }
  
  .achievement-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
  }
  
  .achievement-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    flex: 1;
    margin-right: 20rpx;
    word-break: break-word;
  }
  
  .achievement-status {
    font-size: 24rpx;
    padding: 6rpx 20rpx;
    border-radius: 20rpx;
    font-weight: 500;
    flex-shrink: 0;
  }
  
  .achievement-status.unlocked-text {
    background-color: #e8f5e9;
    color: #07c160;
  }
  
  .achievement-status.locked-text {
    background-color: #f5f5f5;
    color: #999;
  }
  
  .achievement-description {
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
    margin-bottom: 20rpx;
    word-break: break-word;
  }
  
  /* 奖励区域 */
  .achievement-reward {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #fff9e6 0%, #fff0cc 100%);
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
    margin-bottom: 20rpx;
    border: 2rpx dashed #ffc107;
    flex-shrink: 0;
  }
  
  .reward-icon {
    font-size: 36rpx;
    margin-right: 16rpx;
    flex-shrink: 0;
  }
  
  .reward-text {
    font-size: 26rpx;
    color: #e6a23c;
    font-weight: 500;
    word-break: break-word;
  }
  
  /* 进度条 */
  .achievement-progress {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
    flex-shrink: 0;
  }
  
  .progress-container {
    flex: 1;
    height: 16rpx;
    background-color: #f0f0f0;
    border-radius: 8rpx;
    overflow: hidden;
    margin-right: 20rpx;
  }
  
  .progress-fill {
    height: 100%;
    border-radius: 8rpx;
    transition: width 0.3s ease;
  }
  
  .progress-text {
    font-size: 24rpx;
    color: #666;
    min-width: 100rpx;
    text-align: right;
  }
  
  /* 完成时间 */
  .achievement-time {
    margin-top: 20rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
    flex-shrink: 0;
  }
  
  .time-text {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 分享按钮 */
  .achievement-actions {
    margin-top: 24rpx;
    display: flex;
    justify-content: flex-end;
    flex-shrink: 0;
  }
  
  .share-btn {
    background: linear-gradient(135deg, #07c160 0%, #05a050 100%);
    color: white;
    border-radius: 40rpx;
    padding: 16rpx 40rpx;
    font-size: 26rpx;
    font-weight: 500;
    border: none;
    box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  }
  
  .share-btn:active {
    transform: scale(0.98);
  }
  
  .btn-text {
    color: white;
    font-weight: 500;
  }
  
  /* 空状态 */
  .empty-state {
    text-align: center;
    padding: 100rpx 40rpx;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  
  .empty-icon {
    display: block;
    font-size: 120rpx;
    margin-bottom: 32rpx;
    opacity: 0.5;
  }
  
  .empty-text {
    display: block;
    font-size: 36rpx;
    color: #666;
    margin-bottom: 16rpx;
    font-weight: 500;
  }
  
  .empty-subtext {
    display: block;
    font-size: 28rpx;
    color: #999;
  }
  
  /* 底部提示 */
  .bottom-tips {
    background: white;
    padding: 24rpx 32rpx;
    box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
    border-top: 1rpx solid #f0f0f0;
    flex-shrink: 0;
    margin-top: auto;
  }
  
  .tips-text {
    font-size: 26rpx;
    color: #666;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  
  .tips-text::before {
    content: "💡";
    margin-right: 12rpx;
    font-size: 32rpx;
  }
  
  /* 刷新按钮 */
  .refresh-btn {
    position: fixed;
    right: 40rpx;
    bottom: 160rpx;
    width: 100rpx;
    height: 100rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
    z-index: 100;
  }
  
  .refresh-btn:active {
    transform: scale(0.95);
  }
  
  .refresh-icon {
    font-size: 48rpx;
    color: white;
  }
  
  /* 徽章页面背景色 */
  .tab-content:first-child .stats-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
  
  /* 成就页面背景色 */
  .tab-content:last-child .stats-header {
    background: linear-gradient(135deg, #07c160 0%, #05a050 100%);
  }
  
  /* 秘密徽章样式 */
  .badge-item.secret {
    position: relative;
    overflow: hidden;
  }
  
  .badge-item.secret .badge-icon {
    filter: blur(8rpx);
    opacity: 0.7;
  }
  
  .badge-item.secret .badge-name {
    filter: blur(4rpx);
    color: #ccc;
  }
  
  .badge-item.secret::after {
    content: "?";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 40rpx;
    font-weight: bold;
    color: #999;
    z-index: 2;
  }
  
  /* 秘密成就样式 */
  .achievement-item.secret .achievement-icon {
    filter: blur(4rpx);
    opacity: 0.7;
  }
  
  .achievement-item.secret .achievement-title,
  .achievement-item.secret .achievement-description {
    color: #ccc;
  }
  
  /* 滚动条样式 */
  scroll-view::-webkit-scrollbar {
    width: 4rpx;
  }
  
  scroll-view::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4rpx;
  }
  
  scroll-view::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 4rpx;
  }
  
  scroll-view::-webkit-scrollbar-thumb:hover {
    background: #a1a1a1;
  }
  
  /* 响应式调整 */
  @media screen and (max-width: 375px) {
    .badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .badge-item {
      min-height: 220rpx;
    }
    
    .achievement-item {
      min-height: 220rpx;
    }
  }
  
  @media screen and (min-width: 750px) {
    .badges-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }