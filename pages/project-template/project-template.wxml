<view class="project-template-page">
  <view class="header">
    <view class="header-content">
      <text class="header-title">项目模板</text>
      <text class="header-subtitle">选择模板快速创建项目</text>
    </view>
  </view>

  <view class="template-list">
    <view class="template-card" wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="useTemplate">
      <view class="template-header">
        <view class="template-icon">{{item.icon}}</view>
        <view class="template-info">
          <text class="template-name">{{item.name}}</text>
          <view class="template-meta">
            <text class="template-frequency">{{item.frequency}}</text>
            <text class="template-time" wx:if="{{item.reminderTime}}">{{item.reminderTime}}</text>
          </view>
        </view>
      </view>
      <text class="template-desc">{{item.description}}</text>
    </view>
  </view>
</view>