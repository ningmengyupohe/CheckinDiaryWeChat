/* pages/project-template/project-template.wxss */
.project-template-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #f8f9fa 0%, #f0f7ff 100%);
  }
  
  .header {
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    color: white;
    padding: 60rpx 40rpx 50rpx;
    position: relative;
    overflow: hidden;
  }
  
  .header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="40" cy="80" r="1" fill="rgba(255,255,255,0.1)"/></svg>');
    opacity: 0.5;
  }
  
  .header-content {
    text-align: center;
    position: relative;
    z-index: 2;
  }
  
  .header-title {
    display: block;
    font-size: 38rpx;
    font-weight: bold;
    margin-bottom: 16rpx;
    letter-spacing: 1rpx;
  }
  
  .header-subtitle {
    display: block;
    font-size: 26rpx;
    opacity: 0.9;
    font-weight: 300;
  }
  
  .template-list {
    padding: 30rpx;
    margin-top: -20rpx;
    position: relative;
    z-index: 3;
  }
  
  .template-card {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx 32rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 8rpx 30rpx rgba(24, 144, 255, 0.08);
    border: 1rpx solid rgba(24, 144, 255, 0.1);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .template-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6rpx;
    height: 100%;
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .template-card:active {
    transform: translateY(-4rpx);
    box-shadow: 0 12rpx 40rpx rgba(24, 144, 255, 0.15);
  }
  
  .template-card:active::before {
    opacity: 1;
  }
  
  .template-header {
    display: flex;
    align-items: flex-start;
    margin-bottom: 28rpx;
  }
  
  .template-icon {
    width: 80rpx;
    height: 80rpx;
    border-radius: 16rpx;
    background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36rpx;
    margin-right: 24rpx;
    flex-shrink: 0;
    border: 2rpx solid rgba(24, 144, 255, 0.1);
  }
  
  .template-info {
    flex: 1;
  }
  
  .template-name {
    display: block;
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 12rpx;
    line-height: 1.3;
  }
  
  .template-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16rpx;
  }
  
  .template-frequency {
    font-size: 26rpx;
    color: #1890ff;
    font-weight: 500;
    background: rgba(24, 144, 255, 0.1);
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    border: 1rpx solid rgba(24, 144, 255, 0.2);
  }
  
  .template-time {
    font-size: 26rpx;
    color: #52c41a;
    font-weight: 500;
    background: rgba(82, 196, 26, 0.1);
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    border: 1rpx solid rgba(82, 196, 26, 0.2);
  }
  
  .template-desc {
    display: block;
    font-size: 28rpx;
    color: #555;
    line-height: 1.6;
    margin-bottom: 28rpx;
    background: #fafafa;
    padding: 24rpx;
    border-radius: 12rpx;
    border-left: 4rpx solid #1890ff;
  }
  
  .template-stats {
    display: flex;
    justify-content: space-between;
    margin-bottom: 32rpx;
    padding: 0 8rpx;
  }
  
  .stat {
    font-size: 26rpx;
    color: #666;
    display: flex;
    align-items: center;
  }
  
  .stat::before {
    content: '';
    display: inline-block;
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: #1890ff;
    margin-right: 12rpx;
  }
  
  .stat:last-child::before {
    background: #52c41a;
  }
  
  .btn {
    width: 100%;
    padding: 24rpx;
    border-radius: 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    color: white;
    border: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.6s ease;
  }
  
  .btn:active::before {
    left: 100%;
  }
  
  .btn:active {
    transform: scale(0.98);
    box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.3);
  }
  
  /* 添加动画效果 */
  .template-card {
    animation: slideInUp 0.6s ease-out;
  }
  
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30rpx);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* 为每个卡片添加延迟动画 */
  .template-card:nth-child(1) { animation-delay: 0.1s; }
  .template-card:nth-child(2) { animation-delay: 0.2s; }
  .template-card:nth-child(3) { animation-delay: 0.3s; }
  .template-card:nth-child(4) { animation-delay: 0.4s; }
  
  /* 响应式调整 */
  @media (max-width: 375px) {
    .template-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .template-icon {
      margin-right: 0;
      margin-bottom: 16rpx;
    }
    
    .template-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8rpx;
    }
  }